# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Node
node_modules/
.expo/
*.tsbuildinfo

# RoadEye data — never commit survey evidence.
# Raw road video may contain faces, plates and identifiable people (docs/PRIVACY.md),
# and survey bundles are large. Both stay out of version control.
surveys/
data/
*.db
*.db-wal
*.db-shm
*.mp4
*.mov
models/**/*.pt
models/**/*.pth
models/**/*.onnx
ml/experiments/*/predictions/
exports/

# Road geometry — OpenStreetMap is ODbL, and share-alike applies to *data*. An OSM
# extract cached inside a proprietary repository is precisely the ambiguity L-3 in
# docs/LICENSE_AUDIT.md exists to avoid, so networks are fetched at run time into
# data/roads/ and never committed. Tests use invented geometry instead.
data/roads/
*.osm
*.osm.pbf
*.osm.bz2

# OS
.DS_Store

# Demo output
demo_output/

# ML artifacts — datasets and weights are large and licence-encumbered.
# See docs/LICENSE_AUDIT.md: RDD2022-derived models are not distributable.
data/
models/
